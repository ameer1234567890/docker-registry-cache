# Copy to .env and adjust. Every value has a default.

# ---- Docker Hub login ---------------------------------------------------------
# Strongly recommended. Anonymous pulls are limited per IP address, and every client of the cache
# shares the cache's address. Use a personal access token (read-only is enough) as the password.
# Keep this file private: chmod 600 .env
HUB_USERNAME=
HUB_PASSWORD=

# ---- Network ----------------------------------------------------------------
BIND_ADDR=0.0.0.0              # the cache listens on 443 here; use a dedicated IP if 443 is taken
UI_PORT=8080                   # web UI over plain HTTP (also served over TLS on any other name or IP)

# DNS the cache itself uses to reach the real upstream registries.
# Must NOT contain your ghcr.io -> cache override, or requests loop. Use your real resolver
# if the network has no internet DNS access.
UPSTREAM_DNS=1.1.1.1
UPSTREAM_DNS_2=8.8.8.8

# Outbound proxy for the cache's own traffic to the upstream registries (optional).
# HTTPS_PROXY=http://proxy.corp.example:3128
# NO_PROXY=localhost,127.0.0.1

# ---- Where things live ------------------------------------------------------
CACHE_DATA_DIR=./data          # cached blobs, one sub-folder per registry
CERTS_DIR=./certs              # your server.crt + server.key (+ ca.crt)
UPSTREAM_CA_DIR=./certs/upstream  # extra root CAs for talking to upstream registries

# ---- TLS: only used if you do NOT provide server.crt / server.key ------------
TLS_SANS=                      # extra names / IPs on top of the registry hostnames
TLS_REGENERATE=false           # true = reissue the generated certificate on next start
TLS_CA_DAYS=3650
TLS_CERT_DAYS=825

# ---- Cache behaviour --------------------------------------------------------
CACHE_TTL=720h                 # evict cached items this long after they were fetched (0 = never)
CACHE_MAX_SIZE=                # e.g. 50GB: over this, the least recently pulled images are removed first (empty = no limit)
LOG_LEVEL=error                # registry log level (warn also shows two harmless start-up warnings)
UI_SCAN_TTL=30                 # seconds between on-disk rescans by the UI

# ---- Deleting from the web UI ------------------------------------------------
UI_ALLOW_DELETE=true           # false removes every delete button and refuses delete requests
UI_ADMIN_TOKEN=                # if set, the UI asks for it before deleting anything

# ---- Image --------------------------------------------------------------------
# The image to run. Pin a version tag instead of :latest if you want upgrades to be deliberate.
REGISTRY_IMAGE=ameer1234567890/docker-registry-cache:latest
