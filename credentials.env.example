# Copy to credentials.env (optional). Logins for registries OTHER than Docker Hub.
# Docker Hub is configured with HUB_USERNAME / HUB_PASSWORD in .env (see .env.example).
#
# One pair per registry id in registries.conf:
#   <ID>_USERNAME / <ID>_PASSWORD   (id in upper case, '-' becomes '_')

# GitHub Container Registry: only needed for private packages (token with read:packages).
# GHCR_USERNAME=your-github-username
# GHCR_PASSWORD=ghp_xxxxxxxxxxxxxxxx
